{
  "name": "be",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun build --minify --outfile dist/index.js --target bun index.ts",
    "dev": "bun run --hot index.ts",
    "invoice:new-customer": "bun run src/job/new-customer-sheet.ts",
    "invoice:new-customer:db": "bun run src/job/new-customer-db.ts",
    "invoice:old-customer": "bun run src/job/old-customer-sheet.ts",
    "invoice:old-customer:db": "bun run src/job/old-customer-db.ts",
    "employee:crawl": "bun run src/job/employee-crawl.ts",
    "churn:crawl": "bun run src/job/churn-crawl.ts",
    "testimonial:sync": "bun run src/job/testimonial-sheet.ts",
    "churn:carry": "bun run src/job/churn-carry.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/mysql": "^2.15.27"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "axios": "^1.19.0",
    "google-auth-library": "^11.0.0",
    "google-spreadsheet": "^5.3.0",
    "hono": "^4.13.0",
    "mysql2": "^3.23.3",
    "zod": "^4.4.3"
  }
}
