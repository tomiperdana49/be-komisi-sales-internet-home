DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=komisi_sales

NIS_DB_HOST=
NIS_DB_PORT=
NIS_DB_USER=
NIS_DB_PASSWORD=
NIS_DB_NAME=

GOOGLE_SPREADSHEET_ID_NEW_CUSTOMER=
GOOGLE_SPREADSHEET_ID_OLD_CUSTOMER=
# Reseller spreadsheet (tabs "Medan YYYYMM", "Bali YYYYMM", ...) — referral fees for old-customer-db. Empty = no referral fees.
GOOGLE_SPREADSHEET_ID_RESELLER=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

NUSAWORK_API_URL=
NUSAWORK_CLIENT_ID=
NUSAWORK_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

JWT_SECRET=

AUTH_API_URL=
# Enables POST /auth/dev (login as any employee WITHOUT a password). Local development only — never true in production.
ALLOW_DEV_LOGIN=false

# Google Apps Script web app (/exec URL) that stores feedback in a Sheet.
FEEDBACK_URL=
# Google Chat incoming webhook that gets a message for each new feedback (optional).
FEEDBACK_GOOGLE_CHAT_WEBHOOK_URL=
# Feedback Sheet URL, linked from the Google Chat message (optional).
FEEDBACK_SHEET_URL=
# Public origin of THIS backend (it serves /uploads); used to build feedback image links.
APP_URL=http://localhost:3000

PORT=3000

# Customer IDs (comma-separated) whose InvoiceType 8 invoices still count as recurring — the old Apps Script INCLUDE_CUSTOMER_ID property.
OLD_CUSTOMER_INCLUDE_CUSTOMER_IDS=

# Security
# Frontend URL(s) allowed to call this API from a browser, comma-separated. REQUIRED in production,
# e.g. CORS_ORIGINS=https://komisi.example.com — when unset only http://localhost:3000 is allowed.
CORS_ORIGINS=http://localhost:3000
# true only when a reverse proxy you control sets X-Forwarded-For (used to rate-limit login per client IP).
TRUST_PROXY=false
